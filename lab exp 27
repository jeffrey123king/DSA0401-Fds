import pandas as pd

n = int(input("Enter number of players: "))
data = []

for i in range(n):
    name = input("Name: ")
    age = int(input("Age: "))
    position = input("Position: ")
    goals = int(input("Goals: "))
    salary = float(input("Salary: "))
    data.append([name, age, position, goals, salary])

df = pd.DataFrame(data,
    columns=["Name","Age","Position","Goals","Salary"])

print("\nTop 5 Goal Scorers:")
print(df.nlargest(5, "Goals")[["Name","Goals"]])

print("\nAverage Age:", round(df["Age"].mean(), 2))

print("\nPlayers Above Average Age:")
print(df[df["Age"] > df["Age"].mean()][["Name","Age"]])

print("\nPosition Count:")
print(df["Position"].value_counts())
