import numpy as np
from scipy.stats import ttest_ind

n = int(input("Enter number of values: "))

control = []
treatment = []

for i in range(n):
    control.append(float(input("Control value: ")))
    treatment.append(float(input("Treatment value: ")))

t, p = ttest_ind(control, treatment)

print("\nControl Mean:", np.mean(control))
print("Treatment Mean:", np.mean(treatment))
print("P-value:", round(p, 4))

if p < 0.05:
    print("Significant difference")
else:
    print("No significant difference")
