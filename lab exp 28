from sklearn.tree import DecisionTreeRegressor

n = int(input("Enter number of cars: "))
X = []
y = []

for i in range(n):
    print("\nCar", i + 1)
    mileage = float(input("Mileage: "))
    age = float(input("Age: "))
    brand = float(input("Brand: "))
    engine = float(input("Engine: "))
    price = float(input("Price: "))

    X.append([mileage, age, brand, engine])
    y.append(price)

model = DecisionTreeRegressor(max_depth=3)
model.fit(X, y)

print("\nEnter new car details")
mileage = float(input("Mileage: "))
age = float(input("Age: "))
brand = float(input("Brand: "))
engine = float(input("Engine: "))

price = model.predict([[mileage, age, brand, engine]])

print("\nPredicted Price:", round(price[0], 2))
