import pandas as pd
import scipy.stats as stats
import numpy as np

# ------------------------------------
# Replace these values with your data
# ------------------------------------

drug = [12, 15, 10, 18, 14, 16, 13, 17, 11, 15,
         14, 18, 19, 13, 12, 16, 15, 17, 18, 14,
         13, 16, 15, 17, 18]

placebo = [4, 6, 5, 3, 7, 4, 5, 6, 3, 4,
           5, 6, 7, 4, 5, 3, 6, 4, 5, 6,
           3, 5, 4, 6, 5]

# Convert to DataFrame
df = pd.DataFrame({
    "Drug": pd.Series(drug),
    "Placebo": pd.Series(placebo)
})

# Function to calculate 95% confidence interval
def confidence_interval(data, confidence=0.95):
    n = len(data)
    mean = np.mean(data)
    sem = stats.sem(data)          # Standard Error
    margin = sem * stats.t.ppf((1 + confidence) / 2, n - 1)

    return mean, mean - margin, mean + margin

# Drug Group
mean_d, lower_d, upper_d = confidence_interval(drug)

# Placebo Group
mean_p, lower_p, upper_p = confidence_interval(placebo)

print("Drug Group")
print("Mean Reduction =", round(mean_d, 2))
print("95% Confidence Interval = ({:.2f}, {:.2f})".format(lower_d, upper_d))

print("\nPlacebo Group")
print("Mean Reduction =", round(mean_p, 2))
print("95% Confidence Interval = ({:.2f}, {:.2f})".format(lower_p, upper_p))
